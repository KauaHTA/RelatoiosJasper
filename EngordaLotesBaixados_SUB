	<queryString>
		<![CDATA[SELECT
    ROUND(r.gmd, 2) AS gmd,
    ROUND(r.gmc, 2) AS gmc,
    ROUND(r.arroba_por_animal, 2) AS arroba_por_animal,
    ROUND(r.rend_frigorifico, 2) AS rend_frigorifico,
    ROUND(r.rend_ganho, 2) AS rend_ganho,
    ROUND(r.kg_mn_animal_dia, 2) AS kg_mn_animal_dia,
    ROUND(r.kg_ms_animal_dia, 2) AS kg_ms_animal_dia,
    ROUND(r.consumo_pvm, 2) AS consumo_pvm,
    ROUND(r.conversao_alimentar, 2) AS conversao_alimentar,
    ROUND(r.eficiencia_biologica, 2) AS eficiencia_biologica,
    ROUND(r.custo_diaria_alimentar, 2) AS custo_diaria_alimentar,
    ROUND(r.custo_diaria_operacional, 2) AS custo_diaria_operacional,
    ROUND(r.custo_diaria_total, 2) AS custo_diaria_total,
    ROUND(r.custo_arroba_prod_alimentar, 2) AS custo_arroba_prod_alimentar,
    ROUND(r.custo_arroba_prod_operacional, 2) AS custo_arroba_prod_operacional,
    ROUND(r.custo_arroba_total, 2) AS custo_arroba_total,
    -- novos indicadores
    ROUND(s.custo_alimentar * 100
          / NULLIF(s.custo_alimentar + s.custo_operacional + s.custo_sanitario, 0), 2) AS part_alimentar,
    ROUND((s.custo_animal + s.custo_alimentar + s.custo_operacional + s.custo_sanitario)
          / NULLIF(s.qtde_animais, 0), 2) AS custo_cabeca
FROM (
    SELECT
        ROUND(AVG(c.peso_entrada)::numeric, 2) AS peso_entrada,
        ROUND(AVG(c.peso_saida)::numeric, 2) AS peso_saida,
        0 AS peso_carcaca,
        0 AS rend_carcaca,
        AVG(c.qtde_dias)::integer AS qtde_dias,
        COUNT(c.id_animal)::integer AS qtde_animais,
        ROUND(AVG(c.qtde_mn)::numeric, 2) AS qtde_mn,
        ROUND(AVG(c.qtde_ms)::numeric, 2) AS qtde_ms,
        0 AS valor_venda,
        ROUND(COALESCE(SUM(c.custo_animal), 0)::numeric, 2) AS custo_animal,
        ROUND(COALESCE(SUM(c.custo_alimentar), 0)::numeric, 2) AS custo_alimentar,
        ROUND(COALESCE(SUM(c.custo_operacional), 0)::numeric, 2) AS custo_operacional,
        ROUND(COALESCE(SUM(c.custo_sanitario), 0)::numeric, 2) AS custo_sanitario,
        ROUND(AVG(c.valor_arroba_entrada)::numeric, 2) AS valor_arroba_entrada,
        0 AS valor_arroba_venda,
        ROUND(AVG(k.custo_diaria_operacional)::numeric, 2) AS custo_diaria_operacional,
        0 AS valor_imposto_abate
    FROM vw_xgp_engorda_lote_bx c
    JOIN xgp_animal d
      ON d.id_animal = c.id_animal
    LEFT JOIN xgp_aparte e
      ON e.id_aparte = c.id_aparte
    LEFT JOIN xgp_campanha k
      ON k.id_campanha = e.id_campanha
    WHERE c.data_saida >= CAST($P{P_DATA_INICIAL} AS date)
      AND c.data_saida <  CAST($P{P_DATA_FINAL} AS date) + 1
      AND (CAST($P{P_EMPRESA} AS integer)      IS NULL OR d.id_empresa      = $P{P_EMPRESA})
      AND (CAST($P{P_CAMPANHA} AS integer)     IS NULL OR e.id_campanha     = $P{P_CAMPANHA})
      AND (CAST($P{P_ESTRATEGIA} AS integer)   IS NULL OR e.id_estrategia   = $P{P_ESTRATEGIA})
      AND (CAST($P{P_PROPRIETARIO} AS integer) IS NULL OR d.id_proprietario = $P{P_PROPRIETARIO})
) s
LEFT JOIN LATERAL engorda.calcula_resultado(
    s.peso_entrada,
    s.peso_saida,
    s.peso_carcaca,
    s.rend_carcaca,
    s.qtde_dias,
    s.qtde_animais,
    s.qtde_mn,
    s.qtde_ms,
    s.valor_venda,
    s.custo_animal,
    s.custo_alimentar,
    s.custo_operacional,
    s.custo_sanitario,
    s.valor_arroba_entrada,
    s.valor_arroba_venda,
    s.custo_diaria_operacional,
    s.valor_imposto_abate
) r ON TRUE
WHERE s.qtde_animais > 0]]>
	</queryString>
