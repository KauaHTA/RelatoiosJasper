	<parameter name="DATA_INICIAL" class="java.sql.Date"/>
	<parameter name="DATA_FINAL" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[SELECT a.sexo,
	e.id_pessoa,
	p.nome AS nome_pessoa,
	m.descricao,
	ma.data_baixa,
	ma.obs_status,
	a.cod_sysbov,
	cd.descricao AS nome_cidade,
	p.cod_cliente,
	e.nome AS nome_empresa
FROM xgp_animal a
	left join empresa e ON 
	 e.id_empresa = a.id_empresa 
	left join xgp_pessoa p ON 
	 p.id_pessoa = e.id_pessoa 
	left join xpe_endereco uf ON 
	 e.id_pessoa = uf.id_pessoa 
	left join xgp_motivo_morte m ON 
	 m.id_motivo_morte = a.id_motivo_morte 
	left join xgp_morte ma ON 
	 ma.id_animal = a.id_animal 
	left join cidade cd ON 
	 cd.id_cidade = uf.id_cidade 
WHERE 
	 ma.data_baixa BETWEEN $P{DATA_INICIAL} AND $P{DATA_FINAL} 
ORDER BY ma.data_baixa ASC]]></query>
