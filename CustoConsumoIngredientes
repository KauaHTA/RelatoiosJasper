	<queryString language="SQL">
		<![CDATA[WITH base AS (
    SELECT
        f.id_empresa,
        COALESCE(e.nome, 'Empresa ' || f.id_empresa)            AS nome_empresa,
        f.id_formula,
        fo.descricao                                            AS descr_formula,
        fi.id_item_ingrediente                                  AS id_item,
        COALESCE(item.descricao, 'Item ' || fi.id_item_ingrediente) AS nm_ingrediente,
        COALESCE(fi.qtde_realizado, 0)                          AS qtde,
        COALESCE(fi.valor_custo, 0)                             AS custo_unit,
        f.data_fabricacao
    FROM
        xgp_fabrica f
        INNER JOIN xgp_fabrica_item fi ON fi.id_fabrica = f.id_fabrica
        -- CORRECAO: o JOIN com xgp_ingredientes (composicao ATUAL da formula) foi removido.
        -- Quando a formula era alterada (ingrediente trocado/removido), as fabricacoes antigas
        -- que usaram o ingrediente antigo sumiam do relatorio. Agora o ingrediente vem
        -- direto do item fabricado (xgp_fabrica_item).
        LEFT JOIN xgp_item item        ON item.id_item = fi.id_item_ingrediente
        -- CORRECAO: LEFT JOIN para nao perder registros se a formula/empresa nao for encontrada
        LEFT JOIN xgp_formula fo       ON fo.id_formula = f.id_formula
        LEFT JOIN empresa e            ON e.id_empresa = f.id_empresa
    WHERE
        f.data_fabricacao >= COALESCE(CAST($P{P_DATA_INICIO} AS date), DATE '1900-01-01')
        AND f.data_fabricacao < COALESCE(CAST($P{P_DATA_FIM} AS date), DATE '2999-12-31') + INTERVAL '1 day'
        AND (CAST($P{P_ID_FORMULA_INT} AS integer) IS NULL OR f.id_formula = $P{P_ID_FORMULA_INT})
        AND (CAST($P{P_ID_EMPRESA_INT} AS integer) IS NULL OR f.id_empresa = $P{P_ID_EMPRESA_INT})
        AND COALESCE(f.status, 'A') <> 'C'
),
cab AS (
    SELECT
        CAST(COUNT(DISTINCT id_formula) AS integer) AS qt_formula,
        CAST(COUNT(DISTINCT id_empresa) AS integer) AS qt_empresa,
        MIN(id_formula)      AS id_formula_uni,
        MIN(descr_formula)   AS descr_formula_uni,
        MIN(nome_empresa)    AS nome_empresa_uni,
        MIN(data_fabricacao) AS dt_ini_real,
        MAX(data_fabricacao) AS dt_fim_real
    FROM base
)
SELECT
    b.id_empresa,
    b.nome_empresa              AS nome,
    c.descr_formula_uni         AS descricao,
    c.qt_formula,
    c.qt_empresa,
    c.id_formula_uni,
    c.nome_empresa_uni,
    c.dt_ini_real,
    c.dt_fim_real,
    b.id_item,
    b.nm_ingrediente,
    SUM(b.qtde)                 AS qtde_consumida,
    SUM(b.qtde * b.custo_unit)  AS custo_total
FROM
    base b
    CROSS JOIN cab c
GROUP BY
    b.id_empresa,
    b.nome_empresa,
    c.descr_formula_uni,
    c.qt_formula,
    c.qt_empresa,
    c.id_formula_uni,
    c.nome_empresa_uni,
    c.dt_ini_real,
    c.dt_fim_real,
    b.id_item,
    b.nm_ingrediente
ORDER BY
    b.nm_ingrediente]]>
	</queryString>
