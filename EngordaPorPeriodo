	<queryString>
		<![CDATA[WITH bx AS (
    SELECT a.id_animal,
           a.id_aparte,
           a.data_entrada,
           a.data_saida,
           a.peso_entrada,
           a.peso_saida,
           a.qtde_dias,
           a.custo_animal,
           a.custo_alimentar,
           a.custo_operacional,
           a.custo_sanitario,
           a.custo_total,
           e.id_aparte_aux,
           e.descricao,
           g.cod_fracao
      FROM vw_xgp_engorda_lote_bx a
      JOIN xgp_animal d      ON d.id_animal = a.id_animal
      LEFT JOIN xgp_aparte e ON e.id_aparte = a.id_aparte
      LEFT JOIN xgp_fracao g ON g.id_fracao = e.id_fracao
     WHERE a.data_saida >= CAST($P{P_DATA_INICIAL} AS date)
       AND a.data_saida <  CAST($P{P_DATA_FINAL} AS date) + 1
       AND (CAST($P{P_EMPRESA} AS integer)     IS NULL OR d.id_empresa      = $P{P_EMPRESA})
       AND (CAST($P{P_CAMPANHA} AS integer)    IS NULL OR e.id_campanha     = $P{P_CAMPANHA})
       AND (CAST($P{P_ESTRATEGIA} AS integer)  IS NULL OR e.id_estrategia   = $P{P_ESTRATEGIA})
       AND (CAST($P{P_PROPRIETARIO} AS integer) IS NULL OR d.id_proprietario = $P{P_PROPRIETARIO})
),
form AS (
    -- formulas usadas durante toda a vida do lote (nao apenas no periodo de saida)
    SELECT ap.id_aparte_aux,
           STRING_AGG(DISTINCT fo.descricao, ', ') AS desc_formulas
      FROM xgp_agenda_trato agt
      JOIN xgp_agenda_fab af ON af.id_agenda_fab = agt.id_agenda_fab
      JOIN xgp_formula fo    ON fo.id_formula    = af.id_formula
      JOIN xgp_aparte ap     ON ap.id_aparte     = agt.id_aparte
     WHERE agt.id_aparte IN (SELECT DISTINCT id_aparte FROM bx)
     GROUP BY ap.id_aparte_aux
),
lote AS (
    SELECT b.id_aparte_aux,
           b.descricao,
           MIN(b.data_saida) AS data_saida,
           CAST(TO_TIMESTAMP(AVG(EXTRACT(EPOCH FROM b.data_entrada))) AS date) AS data_entrada,
           COUNT(b.id_animal) AS qtde_animais,
           ROUND(AVG(b.qtde_dias)::numeric, 0) AS qtde_dias,
           ROUND(AVG(b.peso_entrada)::numeric, 2) AS peso_entrada,
           ROUND(AVG(b.peso_saida)::numeric, 2) AS peso_saida,
           ROUND(AVG(b.peso_saida - b.peso_entrada)::numeric, 2) AS ganho_peso,
           ROUND(SUM(b.peso_saida - b.peso_entrada)::numeric
                 / NULLIF(SUM(b.qtde_dias), 0), 3) AS gmd,
           ROUND(SUM(b.peso_saida - b.peso_entrada)::numeric / 30, 2) AS arrobas_produzidas,
           ROUND(COALESCE(SUM(b.custo_animal), 0)::numeric, 2)      AS valor_compra,
           ROUND(COALESCE(SUM(b.custo_alimentar), 0)::numeric, 2)   AS custo_alimentar,
           ROUND(COALESCE(SUM(b.custo_operacional), 0)::numeric, 2) AS custo_operacional,
           ROUND(COALESCE(SUM(b.custo_sanitario), 0)::numeric, 2)   AS custo_sanitario,
           ROUND(COALESCE(SUM(b.custo_total), 0)::numeric, 2)       AS custo_total,
           ROUND(COALESCE(SUM(b.custo_total), 0)::numeric
                 / NULLIF(COUNT(b.id_animal), 0), 2) AS custo_cabeca,
           ROUND((COALESCE(SUM(b.custo_alimentar), 0)
                + COALESCE(SUM(b.custo_operacional), 0)
                + COALESCE(SUM(b.custo_sanitario), 0))::numeric
                 / NULLIF(SUM(b.peso_saida - b.peso_entrada)::numeric / 30, 0), 2) AS custo_arroba,
           STRING_AGG(DISTINCT b.cod_fracao::text, ', ') AS desc_areas,
           COALESCE(SUM(b.peso_entrada), 0)::numeric               AS sum_peso_entrada,
           COALESCE(SUM(b.peso_saida), 0)::numeric                 AS sum_peso_saida,
           COALESCE(SUM(b.qtde_dias), 0)::numeric                  AS sum_dias,
           COALESCE(SUM(b.peso_saida - b.peso_entrada), 0)::numeric AS sum_ganho
      FROM bx b
     GROUP BY b.id_aparte_aux, b.descricao
)
SELECT l.*,
       f.desc_formulas,
       (SELECT xc.descricao  FROM xgp_campanha xc     WHERE xc.id_campanha     = $P{P_CAMPANHA})    AS nome_campanha,
       (SELECT emp.nome      FROM empresa emp         WHERE emp.id_empresa     = $P{P_EMPRESA})     AS nome_empresa,
       (SELECT emp.logo_marca FROM empresa emp        WHERE emp.id_empresa     = $P{P_EMPRESA})     AS logo_marca,
       (SELECT xe.descricao  FROM xgp_estrategia xe   WHERE xe.id_estrategia   = $P{P_ESTRATEGIA})  AS nome_estrategia,
       (SELECT xpo.nome      FROM xgp_proprietario xpo WHERE xpo.id_proprietario = $P{P_PROPRIETARIO}) AS nome_proprietario
  FROM lote l
  LEFT JOIN form f ON f.id_aparte_aux = l.id_aparte_aux
 ORDER BY l.data_saida, l.id_aparte_aux]]>
	</queryString>
