	<queryString language="SQL">
		<![CDATA[select
    g.cod_fracao,
    a.descricao,
    d.qtde_animais,
    d.peso_entrada as peso_medio_animais,
    d.peso_objetivo,
    d.data_estimada
from
    xgp_aparte a 
left join
    vw_xgp_lote_previsao d 
        on d.id_aparte = a.id_aparte              
left join
    xgp_fracao g 
        on g.id_fracao = a.id_fracao                     
where
    a.id_empresa = '3' 
    and d.qtde_animais > 0 
    and a.ativo = 'S' 
order by
    g.cod_fracao]]>
	</queryString>
