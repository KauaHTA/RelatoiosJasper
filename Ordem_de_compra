	<queryString language="SQL">
		<![CDATA[WITH
PARCELAS AS (
SELECT X.ID_ORDEM,
STRING_AGG(
TO_CHAR(X.DATA_VENCIMENTO, 'DD/MM/YYYY'),
E'\n' ORDER BY X.NR
) AS PARCELAS,
STRING_AGG(X.NR::TEXT, E'\n' ORDER BY X.NR) AS PARC_NR,
STRING_AGG(COALESCE(TO_CHAR(X.DATA_VENCIMENTO, 'DD/MM/YYYY'), '-'), E'\n' ORDER BY X.NR) AS PARC_VENC,
STRING_AGG('R$ ' || TRANSLATE(TO_CHAR(COALESCE(X.VALOR, 0), 'FM999,999,990.00'), ',.', '.,'), E'\n' ORDER BY X.NR) AS PARC_VALOR,
MIN(X.DATA_VENCIMENTO) AS PRIMEIRO_VENC
FROM (
SELECT ID_ORDEM, DATA_VENCIMENTO, VALOR,
ROW_NUMBER() OVER (PARTITION BY ID_ORDEM ORDER BY DATA_VENCIMENTO, ID_PARCELA) AS NR
FROM XOC_PARCELA
) X
GROUP BY X.ID_ORDEM
),
DRE AS (
SELECT A.ID_ORDEM,
STRING_AGG(
COALESCE(B.NOME, '') ||
' | CCusto: ' || COALESCE(D.DESCRICAO, '') ||
' | Conta: ' || COALESCE(E.DESCR_PATH, '') ||
' | Valor: ' || COALESCE(TO_CHAR(A.VALOR, 'FM999G999G990D00'), ''),
E'\n'
) AS DRE
FROM XOC_ORDEM_DRE A
LEFT JOIN EMPRESA B ON B.ID_EMPRESA = A.ID_EMPRESA
LEFT JOIN XDE_CCUSTO D ON D.ID_CCUSTO = A.ID_CCUSTO
LEFT JOIN VW_XDE_CONTA E ON E.ID_CONTA = A.ID_CONTA
GROUP BY A.ID_ORDEM
),
CONSUMOS AS (
SELECT A.ID_ORDEM,
STRING_AGG(
COALESCE(A.DESCRICAO, '') ||
' | Qtde: ' || COALESCE(A.QTDE::TEXT, '') ||
' | Unitário: ' || COALESCE(A.VALOR_UNITARIO::TEXT, '') ||
' | Total: ' || COALESCE(A.VALOR_TOTAL::TEXT, '') ||
' | Un.: ' || COALESCE(B.UN, ''),
E'\n' ORDER BY A.DESCRICAO
) AS CONSUMOS
FROM XOC_CONSUMO A
INNER JOIN XGP_UNIDADE B ON B.ID_UNIDADE = A.ID_UNIDADE
GROUP BY A.ID_ORDEM
),
SERVICOS AS (
SELECT A.ID_ORDEM,
STRING_AGG(
COALESCE(A.DESCRICAO, '') ||
' | Item: ' || COALESCE(B.DESCRICAO, '') ||
' | Qtde: ' || COALESCE(A.QTDE::TEXT, '') ||
' | Unitário: ' || COALESCE(A.VALOR_UNITARIO::TEXT, '') ||
' | Desconto: ' || COALESCE(A.VALOR_DESCONTO::TEXT, '') ||
' | Total: ' || COALESCE(A.VALOR_TOTAL::TEXT, '') ||
' | Acordado: ' || COALESCE(A.VALOR_ACORDADO::TEXT, ''),
E'\n' ORDER BY A.DESCRICAO
) AS SERVICOS
FROM XOC_SERVICO A
INNER JOIN XGP_ITEM B ON B.ID_ITEM = A.ID_ITEM
GROUP BY A.ID_ORDEM
),
PRODUTOS AS (
SELECT A.ID_ORDEM,
STRING_AGG(
COALESCE(B.DESCRICAO, '') ||
' | Qtde: ' || COALESCE(A.QTDE::TEXT, '') ||
' | Un.: ' || COALESCE(C.UN, '') ||
' | Unitário: ' || COALESCE(A.VALOR_UNITARIO::TEXT, '') ||
' | Desconto: ' || COALESCE(A.VALOR_DESCONTO::TEXT, '') ||
' | Total: ' || COALESCE(A.VALOR_TOTAL::TEXT, '') ||
' | Frete: ' || COALESCE(A.VALOR_FRETE::TEXT, '') ||
' | Atendida: ' || COALESCE(A.QTDE_ATENDIDA::TEXT, ''),
E'\n' ORDER BY B.DESCRICAO
) AS PRODUTOS
FROM XOC_PRODUTO A
INNER JOIN XGP_ITEM B ON B.ID_ITEM = A.ID_ITEM
INNER JOIN XGP_UNIDADE C ON C.ID_UNIDADE = A.ID_UNIDADE
GROUP BY A.ID_ORDEM
),
CONTATOS AS (
SELECT A.ID_PESSOA,
STRING_AGG(
COALESCE(A.NOME, '') ||
CASE WHEN A.CELULAR IS NOT NULL
THEN ' | Celular: ' || A.DDD_CELULAR || '-' || A.CELULAR
ELSE ''
END ||
CASE WHEN A.TELEFONE IS NOT NULL
THEN ' | Telefone: ' || A.DDD_TELEFONE || '-' || A.TELEFONE
ELSE ''
END ||
CASE WHEN A.EMAIL IS NOT NULL
THEN ' | E-mail: ' || A.EMAIL
ELSE ''
END,
E'\n' ORDER BY A.NOME
) AS CONTATOS
FROM XPE_CONTATO A
GROUP BY A.ID_PESSOA
),
SERVICO_QTDE AS (
SELECT ID_ORDEM, MAX(QTDE) AS QTDE_PRODUTO
FROM XOC_SERVICO
GROUP BY ID_ORDEM
)
SELECT
A.ID_ORDEM,
A.ID_COND_PAGTO,
A.ID_OPER_COMPRA,
A.ID_OPERACAO,
A.ID_TAREFA,
A.ID_PESSOA,
A.DESCRICAO,
A.NOME_FORNECEDOR,
A.FONE_FORNEC,
A.TIPO_PIX,
A.PIX_FOR,
A.VALOR_FRETE,
A.VALOR_PRODUTO,
A.VALOR_SERVICO,
A.VALOR_TOTAL,
A.USUARIO_LIBEROU,
A.DATA_ORDEM AS DATA_LIBEROU,
A.DEFINIR_PARC,
A.STATUS,
A.USUARIO_CREATED,
A.DATA_CREATED,
A.USUARIO_CHANGED,
A.DATA_CHANGED,
A.ID_CONTATO,
A.DATA_ORDEM,
A.ID_INDICE,
A.CONTRATO,
A.DATA_EMISSAO,
A.DATA_INICIO,
A.DATA_VENCIMENTO,
A.DIA_VENCIMENTO,
A.DATA_ENTREGA_I,
A.DATA_ENTREGA_F,
A.TIPO_FOR,
A.ID_EMPRESA,
A.ID_ANEXO,
A.DATA_TERMINO,
A.DIAS_ENTRADA,
A.DIAS_INTERVALO,
A.QTDE_PARCELA,
A.VALOR_ENTRADA,
F.DESCRICAO AS FORMA_DE_PAGAMENTO,
cdd.DESCRICAO AS CIDADE_EMPRESA,
cdd_fornecedor.DESCRICAO AS CIDADE_FORNECEDOR,
A.ID_PORTADOR,
A.ID_NATUREZA,
A.ID_FORMA_PAGTO,
A.ID_ITEM,
A.TIPO_FRETE,
A.FORMA_PAGTO,
B.DESCRICAO AS DESCR_TAREFA,
C.DESCRICAO AS DESCR_OPERACAO,
D.NOME AS NOME_PESSOA,
D.NOME_FANTASIA,
D.COD_CLIENTE,
D.EMAIL AS EMAIL_PESSOA,
D.INSCRICAO_ESTADUAL,
D.PRODUTOR_RURAL,

uf.CEP,
uf.RUA,
E.NOME,
est.UF AS NOME_ESTADO,
EP.NOME AS NOME_EMPRESA_PESSOA,
EP.NOME_FANTASIA AS NOME_FANTASIA_EMPRESA,
EP.COD_CLIENTE AS COD_CLIENTE_EMPRESA,
EP.EMAIL AS EMAIL_EMPRESA,
EP.INSCRICAO_ESTADUAL AS INSCRICAO_ESTADUAL_EMPRESA,
EP.PRODUTOR_RURAL AS PRODUTOR_RURAL_EMPRESA,
uf_empresa.CEP AS CEP_EMPRESA,
uf_empresa.RUA AS RUA_EMPRESA,
est_empresa.UF AS NOME_ESTADO_EMPRESA,
P.PRIMEIRO_VENC as data_de_vecimento,
A.VALOR_TOTAL as valor_total_all,
COALESCE(XP.QTDE, XSS.QTDE, XCO.QTDE) AS QTDE,
XP.VALOR_UNITARIO,
COALESCE(XP.VALOR_TOTAL, XSS.VALOR_TOTAL, XCO.VALOR_TOTAL) as aaaa ,
XP.QTDE_ATENDIDA,
XI.DESCRICAO AS DESCRICAO_ITEM,
UF.inscricao_estadual as frn_ie,
UF_EMPRESA.inscricao_estadual as emp_ie,
COALESCE(XSS.DESCRICAO, XCO.DESCRICAO) as DESCRICAO_SERVICO,
COALESCE(XSS.VALOR_UNITARIO, XCO.VALOR_UNITARIO) as VALOR_UN_SERVICO,
CASE
WHEN A.TIPO_FOR = 'C'
THEN D.NOME || COALESCE('/' || D.NOME_FANTASIA, '')
ELSE A.NOME_FORNECEDOR
END AS NOME_FORNECEDOR_CALC,
E.APELIDO AS APELIDO_EMPRESA,
COALESCE(E.LOGO_MARCA, EMA.LOGO_MARCA, ESU.LOGO_MARCA) AS LOGO_MARCA,
F.DESCRICAO AS DESCR_FORMA_PAGTO,
G.DESCRICAO AS DESCR_CATEGORIA,
H.DESCRICAO AS DESCR_GRUPO,
J.CONTATOS,
P.PARCELAS,
P.PARC_NR,
P.PARC_VENC,
P.PARC_VALOR,
R.DRE,
CO.CONSUMOS,
S.SERVICOS,
PR.PRODUTOS,
SQ.QTDE_PRODUTO
FROM XOC_ORDEM A
LEFT JOIN XTD_TAREFA B ON B.ID_TAREFA = A.ID_TAREFA
LEFT JOIN XOC_OPERACAO C ON C.ID_OPERACAO = A.ID_OPERACAO
LEFT JOIN XGP_PESSOA D ON D.ID_PESSOA = A.ID_PESSOA
LEFT JOIN EMPRESA E ON E.ID_EMPRESA = A.ID_EMPRESA
LEFT JOIN EMPRESA EMA ON EMA.ID_EMPRESA = E.ID_MATRIZ
LEFT JOIN EMPRESA ESU ON ESU.ID_EMPRESA = E.ID_EMPRESA_SUPERIOR
LEFT JOIN XGP_PESSOA EP ON EP.ID_PESSOA = E.ID_PESSOA
LEFT JOIN XOC_FORMA_PAGTO F ON F.ID_FORMA_PAGTO = A.ID_FORMA_PAGTO
LEFT JOIN XPE_CATEGORIA G ON G.ID_CATEGORIA = D.ID_CATEGORIA
LEFT JOIN XPE_GRUPO H ON H.ID_GRUPO = D.ID_GRUPO
LEFT JOIN CONTATOS J ON J.ID_PESSOA = A.ID_PESSOA
LEFT JOIN PARCELAS P ON P.ID_ORDEM = A.ID_ORDEM
LEFT JOIN DRE R ON R.ID_ORDEM = A.ID_ORDEM
LEFT JOIN CONSUMOS CO ON CO.ID_ORDEM = A.ID_ORDEM
LEFT JOIN SERVICOS S ON S.ID_ORDEM = A.ID_ORDEM
LEFT JOIN PRODUTOS PR ON PR.ID_ORDEM = A.ID_ORDEM
LEFT JOIN SERVICO_QTDE SQ ON SQ.ID_ORDEM = A.ID_ORDEM
LEFT JOIN XOC_PRODUTO XP ON XP.ID_ORDEM = A.ID_ORDEM AND C.TIPO = 'P'
LEFT JOIN XGP_ITEM XI ON XI.ID_ITEM = XP.ID_ITEM
LEFT JOIN XOC_SERVICO XSS ON XSS.ID_ORDEM = A.ID_ORDEM AND C.TIPO IN ('S', 'C')
LEFT JOIN XOC_CONSUMO XCO ON XCO.ID_ORDEM = A.ID_ORDEM AND C.TIPO IN ('D', 'O', 'A')
LEFT JOIN LATERAL (
SELECT X.*
FROM XPE_ENDERECO X
WHERE X.ID_PESSOA = A.ID_PESSOA
AND X.ATIVO = 'S'
ORDER BY X.ID_ENDERECO
LIMIT 1
) uf ON TRUE
LEFT JOIN ESTADO est ON est.ID_UF = uf.ID_UF
LEFT JOIN CIDADE cdd_fornecedor ON cdd_fornecedor.ID_CIDADE = uf.ID_CIDADE
LEFT JOIN LATERAL (
SELECT X.*
FROM XPE_ENDERECO X
WHERE X.ID_PESSOA = EP.ID_PESSOA
AND X.ATIVO = 'S'
ORDER BY X.ID_ENDERECO
LIMIT 1
) uf_empresa ON TRUE
LEFT JOIN ESTADO est_empresa ON est_empresa.ID_UF = uf_empresa.ID_UF
LEFT JOIN CIDADE cdd ON cdd.ID_CIDADE = uf_empresa.ID_CIDADE
WHERE A.ID_ORDEM = $P{id_ordem}]]>
